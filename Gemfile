source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'
gem 'connection_pool', '2.5.0'

# Standard-library gems that Ruby 3.4+ no longer bundles by default.
# Needed so Jekyll runs on a local modern Ruby; GitHub Pages builds on an
# older Ruby in its own locked environment and ignores these entries.
gem 'erb'
gem 'csv'
gem 'base64'
gem 'logger'
gem 'bigdecimal'
